<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Event Management System</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        /* Modern Navbar */
        .navbar {
            background: white;
            box-shadow: 0 2px 16px rgba(102, 126, 234, 0.08);
            padding: 1rem 0;
            border-bottom: 1px solid rgba(102, 126, 234, 0.1);
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: all 0.3s ease;
        }

            .navbar-brand:hover {
                transform: scale(1.05);
            }

            .navbar-brand img {
                transition: transform 0.3s ease;
            }

            .navbar-brand:hover img {
                transform: scale(1.05);
            }

        .navbar-toggler {
            border: 2px solid #667eea;
            border-radius: 8px;
        }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
            }

        .navbar-nav .nav-link {
            font-weight: 600;
            font-size: 0.95rem;
            color: #64748b;
            padding: 0.5rem 1rem;
            margin: 0 0.25rem;
            border-radius: 8px;
            transition: all 0.3s ease;
            position: relative;
        }

            .navbar-nav .nav-link::before {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 0;
                height: 2px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                transition: width 0.3s ease;
            }

            .navbar-nav .nav-link:hover {
                color: #667eea;
                background: rgba(102, 126, 234, 0.08);
            }

                .navbar-nav .nav-link:hover::before {
                    width: 80%;
                }

            .navbar-nav .nav-link.active {
                color: white;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
            }

        /* Toast Notifications */
        .toast {
            backdrop-filter: blur(10px);
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        }

            .toast.text-bg-success {
                background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%) !important;
            }

            .toast.text-bg-warning {
                background: linear-gradient(135deg, #fa709a 0%, #fee140 100%) !important;
            }

        .toast-body {
            font-weight: 600;
            font-size: 0.95rem;
        }

        /* Footer */
        footer {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 3rem 0 1.5rem;
            margin-top: auto;
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .footer-brand {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .footer-logo {
            font-size: 1.75rem;
            font-weight: 800;
            color: white;
            text-decoration: none;
        }

        .footer-tagline {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .footer-links {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
        }

            .footer-links a {
                color: white;
                text-decoration: none;
                font-weight: 600;
                font-size: 0.95rem;
                transition: all 0.3s ease;
                position: relative;
            }

                .footer-links a::after {
                    content: '';
                    position: absolute;
                    bottom: -4px;
                    left: 0;
                    width: 0;
                    height: 2px;
                    background: white;
                    transition: width 0.3s ease;
                }

                .footer-links a:hover {
                    opacity: 0.8;
                    transform: translateY(-2px);
                }

                    .footer-links a:hover::after {
                        width: 100%;
                    }

        .footer-social {
            display: flex;
            gap: 1rem;
        }

        .social-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            text-decoration: none;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

            .social-icon:hover {
                background: white;
                color: #667eea;
                transform: translateY(-4px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            padding-top: 1.5rem;
            text-align: center;
            font-size: 0.9rem;
            opacity: 0.9;
        }

            .footer-bottom a {
                color: white;
                text-decoration: none;
                font-weight: 600;
                transition: opacity 0.3s ease;
            }

                .footer-bottom a:hover {
                    opacity: 0.8;
                    text-decoration: underline;
                }

        /* Responsive */
        @@media (max-width: 768px) {
            .footer-content {
                flex-direction: column;
                text-align: center;
            }

            .footer-links {
                flex-direction: column;
                gap: 1rem;
            }

            .navbar-nav .nav-link {
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Customer"))
                    {
                        <a class="navbar-brand" asp-controller="Attendee" asp-action="Dashboard">
                            <img src="~/images/logo.png" alt="Event Management Logo" height="50" />
                        </a>
                    }
                    @if (User.IsInRole("Organizer"))
                    {
                        <a class="navbar-brand" asp-controller="Organizer" asp-action="Dashboard">
                            <img src="~/images/logo.png" alt="Event Management Logo" height="50" />
                        </a>

                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="navbar-brand" asp-controller="Admin" asp-action="Dashboard">
                            <img src="~/images/logo.png" alt="Event Management Logo" height="50" />
                        </a>
                    }
                }
                @if (User?.Identity?.IsAuthenticated == false)
                {
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png" alt="Event Management Logo" height="50" />
                    </a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle"></i> About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Faq">
                                <i class="bi bi-question-circle"></i> FAQ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Careers">
                                <i class="bi bi-briefcase"></i> Careers
                            </a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Attendee" asp-action="ProfileInfo">
                                    <i class="bi bi-person-circle"></i> My Profile
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Toast / Notification section -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050">
        @if (TempData["Error"] != null)
        {
            <div class="toast align-items-center text-bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toastElList = [].slice.call(document.querySelectorAll('.toast'));
            if (toastElList.length > 0) {
                var toastList = toastElList.map(function (toastEl) {
                    return new bootstrap.Toast(toastEl, { delay: 4000 });
                });
                toastList.forEach(toast => toast.show());
            }
        });
    </script>

    <!-- Main Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <div class="footer-logo">
                        <i class="bi bi-calendar-event"></i> Eventora
                    </div>
                    <div class="footer-tagline">Your Gateway to Amazing Events</div>
                </div>

                <div class="footer-links">
                    <a asp-controller="Home" asp-action="About">About Us</a>
                    <a asp-controller="Home" asp-action="Faq">FAQ</a>
                    <a asp-controller="Home" asp-action="Careers">Careers</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a href="#">Terms of Service</a>
                </div>

                <div class="footer-social">
                    <a href="#" class="social-icon" title="Facebook">
                        <i class="bi bi-facebook"></i>
                    </a>
                    <a href="#" class="social-icon" title="Twitter">
                        <i class="bi bi-twitter"></i>
                    </a>
                    <a href="#" class="social-icon" title="Instagram">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <a href="#" class="social-icon" title="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                </div>
            </div>

            <div class="footer-bottom">
                &copy; 2025 Event Management System. All rights reserved. |
                Made with <i class="bi bi-heart-fill" style="color: #ff6b6b;"></i> by Eventora Team
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>