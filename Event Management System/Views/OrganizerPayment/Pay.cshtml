@model Event_Management_System.DTOs.OrganizerApplicationCreateDTO
@{
    ViewBag.Title = "Organizer Payment";
}

<style>
    .payment-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 2.5rem 2rem;
        margin-bottom: 2.5rem;
        color: white;
        box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3);
        text-align: center;
    }

        .payment-hero h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .payment-hero p {
            font-size: 1.05rem;
            opacity: 0.95;
            margin: 0;
        }

    .payment-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .summary-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        margin-bottom: 2rem;
        border: 1px solid #e8e8f5;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e8e8f5;
    }

        .section-header h3 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

    .section-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .info-grid {
        display: grid;
        gap: 1.25rem;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .info-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        font-size: 1.05rem;
        color: #1a1a2e;
        font-weight: 500;
    }

        .info-value a {
            color: #667eea;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .info-value a:hover {
                color: #764ba2;
                text-decoration: underline;
            }

    .amount-highlight {
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        border: 2px solid #667eea;
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1rem;
        text-align: center;
    }

    .amount-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 0.5rem;
    }

    .amount-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #667eea;
    }

    .payment-form-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        border: 1px solid #e8e8f5;
    }

    #card-element {
        background: #f8f9fa;
        padding: 1.25rem;
        border-radius: 12px;
        border: 2px solid #e8e8f5;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        #card-element:focus-within {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .card-info-text {
        font-size: 0.875rem;
        color: #64748b;
        margin-top: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .secure-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
        margin-top: 1rem;
    }

    .pay-button {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 1.25rem 3rem;
        font-size: 1.15rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(67, 233, 123, 0.3);
        width: 100%;
        margin-top: 1.5rem;
    }

        .pay-button:hover:not(:disabled) {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(67, 233, 123, 0.4);
            background: linear-gradient(135deg, #32d86a 0%, #27e8c6 100%);
        }

        .pay-button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .payment-icons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e8e8f5;
    }

    .payment-icon-text {
        font-size: 0.875rem;
        color: #64748b;
        font-weight: 500;
    }

    .card-brands {
        display: flex;
        gap: 0.5rem;
        opacity: 0.7;
    }

    .loading-spinner {
        display: none;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .pay-button.processing .button-text {
        display: none;
    }

    .pay-button.processing .loading-spinner {
        display: block;
    }

    @@media (max-width: 768px) {
        .payment-hero h1 {
            font-size: 1.5rem;
        }

        .summary-card, .payment-form-card {
            padding: 1.5rem;
        }

        .amount-value {
            font-size: 2rem;
        }
    }
</style>

<!-- Hero Header -->
<div class="payment-hero">
    <h1>💳 Complete Your Payment</h1>
    <p>Secure payment processing for your organizer application</p>
</div>

<div class="payment-container">
    <!-- Application Summary -->
    <div class="summary-card">
        <div class="section-header">
            <div class="section-icon">📋</div>
            <h3>Application Summary</h3>
        </div>

        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Organization Name</span>
                <span class="info-value">@Model.OrganizationName</span>
            </div>

            <div class="info-item">
                <span class="info-label">Contact Email</span>
                <span class="info-value">@Model.ContactEmail</span>
            </div>

            <div class="info-item">
                <span class="info-label">Contact Phone</span>
                <span class="info-value">@Model.ContactPhone</span>
            </div>

            <div class="info-item">
                <span class="info-label">Experience Description</span>
                <span class="info-value">@Model.ExperienceDescription</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
            {
                <div class="info-item">
                    <span class="info-label">Website</span>
                    <span class="info-value">
                        <a href="@Model.WebsiteUrl" target="_blank" rel="noopener noreferrer">
                            @Model.WebsiteUrl
                        </a>
                    </span>
                </div>
            }
        </div>

        <div class="amount-highlight">
            <div class="amount-label">Application Fee</div>
            <div class="amount-value">$50.00</div>
        </div>
    </div>

    <!-- Payment Form -->
    <div class="payment-form-card">
        <div class="section-header">
            <div class="section-icon">💳</div>
            <h3>Payment Details</h3>
        </div>

        <form method="post" asp-action="Confirm" id="payment-form">
            <div id="card-element"></div>

            <p class="card-info-text">
                <span>🔒</span>
                <span>Your payment information is secure and encrypted</span>
            </p>

            <div class="secure-badge">
                <span>🛡️</span>
                <span>Powered by Stripe</span>
            </div>

            <input type="hidden" id="paymentIntentId" name="paymentIntentId" />

            <button type="button" id="payBtn" class="pay-button">
                <span class="button-text">💰 Pay $50.00</span>
                <div class="loading-spinner"></div>
            </button>

            <div class="payment-icons">
                <span class="payment-icon-text">We accept:</span>
                <div class="card-brands">
                    <span>💳</span>
                    <span>Visa</span>
                    <span>•</span>
                    <span>Mastercard</span>
                    <span>•</span>
                    <span>Amex</span>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
    const stripe = Stripe('@ViewBag.PublishableKey');
    const elements = stripe.elements();
    const card = elements.create('card', {
        style: {
            base: {
                fontSize: '16px',
                color: '#1a1a2e',
                fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
                '::placeholder': {
                    color: '#94a3b8'
                }
            },
            invalid: {
                color: '#ef4444',
                iconColor: '#ef4444'
            }
        }
    });
    card.mount('#card-element');

    const payBtn = document.getElementById('payBtn');
    const form = document.getElementById('payment-form');

    payBtn.onclick = async () => {
        // Disable button and show loading state
        payBtn.disabled = true;
        payBtn.classList.add('processing');

        try {
            const result = await stripe.confirmCardPayment(
                '@ViewBag.ClientSecret',
                { payment_method: { card: card } }
            );

            if (result.paymentIntent && result.paymentIntent.status === 'succeeded') {
                document.getElementById('paymentIntentId').value = result.paymentIntent.id;
                form.submit();
            } else {
                const message = result.error ? result.error.message : "Payment could not be processed";
                alert('❌ Payment failed: ' + message);

                // Re-enable button
                payBtn.disabled = false;
                payBtn.classList.remove('processing');
            }
        } catch (error) {
            alert('❌ An error occurred. Please try again.');
            payBtn.disabled = false;
            payBtn.classList.remove('processing');
        }
    };

    // Handle card errors
    card.on('change', (event) => {
        const cardElement = document.getElementById('card-element');
        if (event.error) {
            cardElement.style.borderColor = '#ef4444';
        } else if (event.complete) {
            cardElement.style.borderColor = '#43e97b';
        } else {
            cardElement.style.borderColor = '#e8e8f5';
        }
    });
</script>