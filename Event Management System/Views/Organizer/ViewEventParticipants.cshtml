@model IEnumerable<Event_Management_System.DTOs.EventParticipantDTO>
@{
    ViewData["Title"] = "Event Participants";
    var totalParticipants = Model.Count();
    var checkedIn = Model.Count(p => p.CheckInStatus);

    var paidCount = Model.Count(p => p.PaymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase));
    var notCheckedIn = totalParticipants - paidCount;
}

<!-- Page Header -->
<div class="participants-hero">
    <div class="container">
        <div class="hero-content-participants">
            <div class="breadcrumb-nav-participants">
                <a href="javascript:history.back()" class="breadcrumb-link-participants">
                    <i class="bi bi-arrow-left"></i>
                    Back to Event Details
                </a>
            </div>
            <div class="header-info-participants">
                <div class="header-icon-participants">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h1 class="participants-title">Event Participants</h1>
                    <p class="participants-subtitle">Manage and track all registered attendees</p>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="stats-container-participants">
                <div class="stat-card-participants">
                    <div class="stat-icon-participants total">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="stat-content-participants">
                        <span class="stat-number-participants">@totalParticipants</span>
                        <span class="stat-label-participants">Total Participants</span>
                    </div>
                </div>

                <div class="stat-card-participants">
                    <div class="stat-icon-participants checked">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="stat-content-participants">
                        <span class="stat-number-participants">@checkedIn</span>
                        <span class="stat-label-participants">Checked In</span>
                    </div>
                </div>

                <div class="stat-card-participants">
                    <div class="stat-icon-participants pending">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div class="stat-content-participants">
                        <span class="stat-number-participants">@notCheckedIn</span>
                        <span class="stat-label-participants">Pending</span>
                    </div>
                </div>

                <div class="stat-card-participants">
                    <div class="stat-icon-participants paid">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div class="stat-content-participants">
                        <span class="stat-number-participants">@paidCount</span>
                        <span class="stat-label-participants">Paid</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    @if (!Model.Any())
    {
        <div class="empty-state-participants">
            <div class="empty-icon-participants">
                <i class="bi bi-person-x"></i>
            </div>
            <h3>No Participants Yet</h3>
            <p>No one has registered for this event yet. Share your event to get more participants!</p>
        </div>
    }
    else
    {
        <div class="participants-card">
            <div class="card-header-participants">
                <div class="header-left">
                    <h4 class="card-title-participants">
                        <i class="bi bi-list-ul"></i>
                        Participants List
                    </h4>
                    <p class="card-subtitle-participants">@totalParticipants @(totalParticipants == 1 ? "person" : "people") registered</p>
                </div>
                <div class="header-actions">
                    <button class="action-btn-header export">
                        <i class="bi bi-download"></i>
                        Export List
                    </button>
                    <button class="action-btn-header filter">
                        <i class="bi bi-funnel"></i>
                        Filter
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="participants-table">
                    <thead>
                        <tr>
                            <th>
                                <i class="bi bi-person-badge"></i>
                                Name
                            </th>
                            <th>
                                <i class="bi bi-envelope"></i>
                                Email
                            </th>
                            <th>
                                <i class="bi bi-calendar-plus"></i>
                                Registered On
                            </th>
                            <th>
                                <i class="bi bi-wallet2"></i>
                                Payment Status
                            </th>
                            <th>
                                <i class="bi bi-check-square"></i>
                                Check-In Status
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var participant in Model)
                        {
                            <tr class="participant-row">
                                <td>
                                    <div class="participant-name">
                                        <div class="avatar-circle">
                                            @participant.UserName.Substring(0, 1).ToUpper()
                                        </div>
                                        <span>@participant.UserName</span>
                                    </div>
                                </td>
                                <td>
                                    <a href="mailto:@participant.Email" class="email-link">
                                        @participant.Email
                                    </a>
                                </td>
                                <td>
                                    <span class="date-text">@participant.RegisteredOn.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td>
                                    @if (participant.PaymentStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge paid">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Paid
                                        </span>
                                    }
                                    else if (participant.PaymentStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge pending">
                                            <i class="bi bi-clock-fill"></i>
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge unpaid">
                                            <i class="bi bi-x-circle-fill"></i>
                                            @participant.PaymentStatus
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (participant.CheckInStatus)
                                    {
                                        <span class="checkin-badge checked-in">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Checked In
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="checkin-badge not-checked">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Not Checked In
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer-participants">
                <div class="footer-info">
                    <i class="bi bi-info-circle"></i>
                    Showing @totalParticipants of @totalParticipants participants
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Hero Section */
    .participants-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 2rem 0 3rem;
        position: relative;
        overflow: hidden;
    }

        .participants-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><rect width="100" height="100" fill="none"/><circle cx="50" cy="50" r="40" fill="rgba(255,255,255,0.05)"/></svg>');
            opacity: 0.3;
        }

    .hero-content-participants {
        position: relative;
        z-index: 2;
        color: white;
    }

    .breadcrumb-nav-participants {
        margin-bottom: 1.5rem;
    }

    .breadcrumb-link-participants {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: rgba(255, 255, 255, 0.9);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

        .breadcrumb-link-participants:hover {
            color: white;
            transform: translateX(-5px);
        }

        .breadcrumb-link-participants i {
            font-size: 1.1rem;
        }

    .header-info-participants {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .header-icon-participants {
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
    }

    .participants-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0 0 0.25rem 0;
    }

    .participants-subtitle {
        font-size: 1.125rem;
        opacity: 0.95;
        margin: 0;
    }

    /* Statistics Cards */
    .stats-container-participants {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .stat-card-participants {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 15px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.3s ease;
    }

        .stat-card-participants:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-5px);
        }

    .stat-icon-participants {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        color: white;
        flex-shrink: 0;
    }

        .stat-icon-participants.total {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .stat-icon-participants.checked {
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        }

        .stat-icon-participants.pending {
            background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
        }

        .stat-icon-participants.paid {
            background: linear-gradient(135deg, #4299e1 0%, #3182ce 100%);
        }

    .stat-content-participants {
        display: flex;
        flex-direction: column;
    }

    .stat-number-participants {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1;
    }

    .stat-label-participants {
        font-size: 0.875rem;
        opacity: 0.9;
        font-weight: 600;
    }

    /* Participants Card */
    .participants-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
        border: 2px solid #e2e8f0;
        overflow: hidden;
    }

    .card-header-participants {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem;
        border-bottom: 2px solid #e2e8f0;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .header-left {
        flex: 1;
    }

    .card-title-participants {
        font-size: 1.5rem;
        font-weight: 800;
        color: #2d3748;
        margin: 0 0 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .card-title-participants i {
            color: #667eea;
            font-size: 1.5rem;
        }

    .card-subtitle-participants {
        color: #718096;
        margin: 0;
        font-size: 0.95rem;
    }

    .header-actions {
        display: flex;
        gap: 1rem;
    }

    .action-btn-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        border: 2px solid #e2e8f0;
        background: white;
        color: #4a5568;
        font-weight: 700;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .action-btn-header:hover {
            border-color: #667eea;
            color: #667eea;
            transform: translateY(-2px);
        }

        .action-btn-header i {
            font-size: 1rem;
        }

    /* Table */
    .table-responsive {
        overflow-x: auto;
    }

    .participants-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .participants-table thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

            .participants-table thead tr th {
                padding: 1.25rem 1.5rem;
                font-weight: 700;
                font-size: 0.95rem;
                text-align: left;
                white-space: nowrap;
            }

                .participants-table thead tr th:first-child {
                    border-top-left-radius: 0;
                }

                .participants-table thead tr th:last-child {
                    border-top-right-radius: 0;
                }

                .participants-table thead tr th i {
                    margin-right: 0.5rem;
                    font-size: 1rem;
                }

    .participant-row {
        transition: all 0.3s ease;
        border-bottom: 1px solid #e2e8f0;
    }

        .participant-row:hover {
            background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
        }

        .participant-row td {
            padding: 1.25rem 1.5rem;
            vertical-align: middle;
        }

    /* Participant Name with Avatar */
    .participant-name {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .avatar-circle {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.125rem;
        flex-shrink: 0;
    }

    .participant-name span {
        font-weight: 700;
        color: #2d3748;
        font-size: 1rem;
    }

    /* Email Link */
    .email-link {
        color: #4a5568;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .email-link:hover {
            color: #667eea;
            text-decoration: underline;
        }

    /* Date Text */
    .date-text {
        color: #4a5568;
        font-weight: 600;
        font-size: 0.95rem;
    }

    /* Status Badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.875rem;
        white-space: nowrap;
    }

        .status-badge i {
            font-size: 0.875rem;
        }

        .status-badge.paid {
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
            color: white;
        }

        .status-badge.pending {
            background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
            color: #2d3748;
        }

        .status-badge.unpaid {
            background: linear-gradient(135deg, #fc8181 0%, #f56565 100%);
            color: white;
        }

    /* Check-in Badges */
    .checkin-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.875rem;
        white-space: nowrap;
    }

        .checkin-badge i {
            font-size: 0.875rem;
        }

        .checkin-badge.checked-in {
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
            color: white;
        }

        .checkin-badge.not-checked {
            background: linear-gradient(135deg, #fc8181 0%, #f56565 100%);
            color: white;
        }

    /* Card Footer */
    .card-footer-participants {
        padding: 1.5rem 2rem;
        border-top: 2px solid #e2e8f0;
        background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
    }

    .footer-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #718096;
        font-weight: 600;
        font-size: 0.95rem;
    }

        .footer-info i {
            color: #667eea;
            font-size: 1.1rem;
        }

    /* Empty State */
    .empty-state-participants {
        text-align: center;
        padding: 4rem 2rem;
        background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
        border-radius: 20px;
        border: 2px dashed #cbd5e0;
    }

    .empty-icon-participants {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e0 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        color: #a0aec0;
        font-size: 4rem;
    }

    .empty-state-participants h3 {
        font-size: 1.75rem;
        font-weight: 800;
        color: #2d3748;
        margin-bottom: 0.5rem;
    }

    .empty-state-participants p {
        color: #718096;
        font-size: 1.125rem;
        margin: 0;
    }

    /* Responsive Design */
    @@media (max-width: 991px) {
        .participants-title {
            font-size: 2rem;
        }

        .stats-container-participants {
            grid-template-columns: repeat(2, 1fr);
        }

        .card-header-participants {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-actions {
            width: 100%;
            flex-direction: column;
        }

        .action-btn-header {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 768px) {
        .participants-hero {
            padding: 1.5rem 0 2rem;
        }

        .header-info-participants {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-icon-participants {
            width: 60px;
            height: 60px;
            font-size: 2rem;
        }

        .participants-title {
            font-size: 1.75rem;
        }

        .participants-subtitle {
            font-size: 1rem;
        }

        .stats-container-participants {
            grid-template-columns: 1fr;
        }

        .participants-table {
            font-size: 0.875rem;
        }

        .participant-name {
            flex-direction: column;
            align-items: flex-start;
        }

        .avatar-circle {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }
    }

    @@media (max-width: 576px) {
        .empty-state-participants {
            padding: 3rem 1.5rem;
        }

        .empty-icon-participants {
            width: 100px;
            height: 100px;
            font-size: 3rem;
        }
    }
</style>