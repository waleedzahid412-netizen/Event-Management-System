@using Event_Management_System.DTOs
@model OrganizerDashboardDTO
@{
    ViewData["Title"] = "Organizer Dashboard";
}

<style>
    .dashboard-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 3rem 2rem;
        margin-bottom: 2.5rem;
        color: white;
        box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3);
    }

        .dashboard-hero h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .dashboard-hero p {
            font-size: 1.1rem;
            opacity: 0.95;
            margin: 0;
        }

    .stat-card {
        border: none;
        border-radius: 16px;
        padding: 1.5rem;
        transition: all 0.3s ease;
        background: white;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            transition: height 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 32px rgba(102, 126, 234, 0.2);
        }

            .stat-card:hover::before {
                height: 6px;
            }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        margin-bottom: 1rem;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
        color: #667eea;
    }

    .stat-card .card-body {
        padding: 0;
    }

    .stat-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #1a1a2e;
        line-height: 1;
        margin: 0;
    }

    .dashboard-actions {
        background: white;
        padding: 2rem;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .action-btn {
        border: none;
        border-radius: 16px;
        padding: 2.5rem 1.5rem;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        height: 200px;
        text-align: center;
        text-decoration: none;
        width: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

        .action-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(102, 126, 234, 0.3);
            text-decoration: none;
            background: linear-gradient(135deg, #5568d3 0%, #653a8b 100%);
            color: white;
        }

        .action-btn .btn-icon {
            font-size: 3rem;
            line-height: 1;
        }

        .action-btn .btn-text {
            font-size: 1rem;
            line-height: 1.4;
        }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 1400px) {
        .action-btn {
            padding: 2rem 1rem;
            font-size: 0.9rem;
        }

            .action-btn .btn-icon {
                font-size: 2.5rem;
            }

            .action-btn .btn-text {
                font-size: 0.9rem;
            }
    }

    @@media (max-width: 1200px) {
        .action-btn {
            height: 180px;
            padding: 1.5rem 1rem;
        }

            .action-btn .btn-icon {
                font-size: 2rem;
            }
    }

    @@media (max-width: 768px) {
        .dashboard-hero h1 {
            font-size: 2rem;
        }

        .stat-value {
            font-size: 2rem;
        }

        .action-btn {
            height: 160px;
        }
    }
</style>

<!-- Hero Header -->
<div class="dashboard-hero text-center">
    <h1>🎯 Organizer Dashboard</h1>
    <p>Manage your events, track registrations, and grow your audience</p>
</div>

<!-- Stats Section -->
<div class="row mb-5 g-4">
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">📊</div>
                <div class="stat-label">Total Events</div>
                <h3 class="stat-value">@Model.TotalEvents</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">📅</div>
                <div class="stat-label">Upcoming Events</div>
                <h3 class="stat-value">@Model.UpcomingEvents</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">👥</div>
                <div class="stat-label">Total Registrations</div>
                <h3 class="stat-value">@Model.TotalRegistrations</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">✨</div>
                <div class="stat-label">Active Events</div>
                <h3 class="stat-value">@Model.ActiveEvents</h3>
            </div>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="dashboard-actions">
    <h2 class="section-title">Quick Actions</h2>
    <div class="row g-3">
        <div class="col">
            <a asp-controller="Event" asp-action="CreateEvent" class="action-btn">
                <span class="btn-icon">➕</span>
                <span class="btn-text">Create New Event</span>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Event" asp-action="OrganizedEvents" class="action-btn">
                <span class="btn-icon">📋</span>
                <span class="btn-text">Organized Events</span>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Event" asp-action="BrowseEvents" class="action-btn">
                <span class="btn-icon">🔍</span>
                <span class="btn-text">Register For an Event</span>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Event" asp-action="UserEvents" class="action-btn">
                <span class="btn-icon">📝</span>
                <span class="btn-text">Registered Events</span>
            </a>
        </div>
        <div class="col">
            <a asp-controller="Organizer" asp-action="AnalyticsDashboard" class="action-btn">
                <span class="btn-icon">📈</span>
                <span class="btn-text">View Analytics</span>
            </a>
        </div>
    </div>
</div>