@using Event_Management_System.DTOs
@model OrganizerDashboardDTO
@{
    ViewData["Title"] = "Organizer Dashboard";
}

<style>
    .dashboard-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 3rem 2rem;
        margin-bottom: 2.5rem;
        color: white;
        box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3);
    }

        .dashboard-hero h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .dashboard-hero p {
            font-size: 1.1rem;
            opacity: 0.95;
            margin: 0;
        }

    .stat-card {
        border: none;
        border-radius: 16px;
        padding: 1.5rem;
        transition: all 0.3s ease;
        background: white;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            transition: height 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 32px rgba(102, 126, 234, 0.2);
        }

            .stat-card:hover::before {
                height: 6px;
            }

        .stat-card.card-1::before {
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        }

        .stat-card.card-2::before {
            background: linear-gradient(90deg, #f093fb 0%, #f5576c 100%);
        }

        .stat-card.card-3::before {
            background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
        }

        .stat-card.card-4::before {
            background: linear-gradient(90deg, #43e97b 0%, #38f9d7 100%);
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        margin-bottom: 1rem;
    }

    .stat-card.card-1 .stat-icon {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
        color: #667eea;
    }

    .stat-card.card-2 .stat-icon {
        background: linear-gradient(135deg, rgba(240, 147, 251, 0.15) 0%, rgba(245, 87, 108, 0.15) 100%);
        color: #f5576c;
    }

    .stat-card.card-3 .stat-icon {
        background: linear-gradient(135deg, rgba(79, 172, 254, 0.15) 0%, rgba(0, 242, 254, 0.15) 100%);
        color: #4facfe;
    }

    .stat-card.card-4 .stat-icon {
        background: linear-gradient(135deg, rgba(67, 233, 123, 0.15) 0%, rgba(56, 249, 215, 0.15) 100%);
        color: #43e97b;
    }

    .stat-card .card-body {
        padding: 0;
    }

    .stat-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: #1a1a2e;
        line-height: 1;
        margin: 0;
    }

    .dashboard-actions {
        background: white;
        padding: 2rem;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .action-btn {
        border: none;
        border-radius: 12px;
        padding: 1rem 1.75rem;
        font-size: 1rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

        .action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

    .btn-primary.action-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

        .btn-primary.action-btn:hover {
            background: linear-gradient(135deg, #5568d3 0%, #653a8b 100%);
        }

    .btn-secondary.action-btn {
        background: linear-gradient(135deg, #868CFF 0%, #4318FF 100%);
        color: white;
    }

        .btn-secondary.action-btn:hover {
            background: linear-gradient(135deg, #7178ee 0%, #3610e8 100%);
        }

    .btn-success.action-btn {
        background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        color: white;
    }

        .btn-success.action-btn:hover {
            background: linear-gradient(135deg, #32d86a 0%, #27e8c6 100%);
        }

    .btn-info.action-btn {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
    }

        .btn-info.action-btn:hover {
            background: linear-gradient(135deg, #3e9bed 0%, #00e1ed 100%);
        }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 768px) {
        .dashboard-hero h1 {
            font-size: 2rem;
        }

        .stat-value {
            font-size: 2rem;
        }

        .action-btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<!-- Hero Header -->
<div class="dashboard-hero text-center">
    <h1>🎯 Organizer Dashboard</h1>
    <p>Manage your events, track registrations, and grow your audience</p>
</div>

<!-- Stats Section -->
<div class="row mb-5 g-4">
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card card-1">
            <div class="card-body">
                <div class="stat-icon">📊</div>
                <div class="stat-label">Total Events</div>
                <h3 class="stat-value">@Model.TotalEvents</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card card-2">
            <div class="card-body">
                <div class="stat-icon">📅</div>
                <div class="stat-label">Upcoming Events</div>
                <h3 class="stat-value">@Model.UpcomingEvents</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card card-3">
            <div class="card-body">
                <div class="stat-icon">👥</div>
                <div class="stat-label">Total Registrations</div>
                <h3 class="stat-value">@Model.TotalRegistrations</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card card-4">
            <div class="card-body">
                <div class="stat-icon">✨</div>
                <div class="stat-label">Active Events</div>
                <h3 class="stat-value">@Model.ActiveEvents</h3>
            </div>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="dashboard-actions">
    <h2 class="section-title">Quick Actions</h2>
    <div class="d-flex flex-wrap gap-3">
        <a asp-controller="Organizer" asp-action="CreateEvent" class="btn btn-primary btn-lg action-btn">
            <span>➕</span>
            <span>Create New Event</span>
        </a>
        <a asp-controller="Organizer" asp-action="MyEvents" class="btn btn-secondary btn-lg action-btn">
            <span>📋</span>
            <span>My Events</span>
        </a>
        <a asp-controller="Organizer" asp-action="EventRegistrations" class="btn btn-success btn-lg action-btn">
            <span>👥</span>
            <span>View Registrations</span>
        </a>
        <a asp-controller="Profile" asp-action="Edit" class="btn btn-info btn-lg action-btn">
            <span>⚙️</span>
            <span>Edit Profile</span>
        </a>
    </div>
</div>