@using Event_Management_System.ViewModels
@model AdminChartsVM

<style>
    .analytics-dashboard {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        padding: 2rem 0;
    }

    .analytics-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 2.5rem;
        margin-bottom: 2.5rem;
        color: white;
        box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
    }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 800;
    }

    .hero-subtitle {
        font-size: 1.1rem;
        opacity: 0.95;
    }

    .filter-wrapper {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .filter-buttons {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 0.875rem 2rem;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        border: 2px solid #e8e8f5;
        color: #64748b;
        transition: all 0.3s ease;
    }

        .filter-btn.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-color: transparent;
        }

    .chart-card {
        background: white;
        border-radius: 16px;
        padding: 1.75rem;
        height: 420px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .chart-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 1rem;
    }

    .chart-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: rgba(102, 126, 234, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .chart-container {
        height: 100%;
    }
</style>

<div class="analytics-dashboard">
    <div class="container">

        <!-- HERO -->
        <div class="analytics-hero">
            <h1 class="hero-title">📊 Admin Analytics</h1>
            <p class="hero-subtitle">Platform insights and performance overview</p>
        </div>

        <!-- FILTERS -->
        <div class="filter-wrapper">
            <div class="filter-buttons">
                <a asp-action="Analytics" asp-route-filter="Week"
                   class="filter-btn @(Model.SelectedFilter == DateFilterType.Week ? "active" : "")">
                    Last 7 Days
                </a>

                <a asp-action="Analytics" asp-route-filter="Month"
                   class="filter-btn @(Model.SelectedFilter == DateFilterType.Month ? "active" : "")">
                    Last 30 Days
                </a>

                <a asp-action="Analytics" asp-route-filter="Year"
                   class="filter-btn @(Model.SelectedFilter == DateFilterType.Year ? "active" : "")">
                    Last 12 Months
                </a>
            </div>
        </div>

        <!-- CHARTS -->
        <div class="row g-4">

            <!-- Events by Status -->
            <div class="col-lg-6">
                <div class="chart-card">
                    <div class="chart-header">
                        <div class="chart-icon">🎯</div>
                        <h5>Events by Status</h5>
                    </div>
                    <div class="chart-container">
                        <canvas id="eventsByStatusChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Registrations per Event -->
            <div class="col-lg-6">
                <div class="chart-card">
                    <div class="chart-header">
                        <div class="chart-icon">👥</div>
                        <h5>Registrations per Event</h5>
                    </div>
                    <div class="chart-container">
                        <canvas id="registrationsPerEventChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Revenue Over Time -->
            <div class="col-12">
                <div class="chart-card">
                    <div class="chart-header">
                        <div class="chart-icon">💰</div>
                        <h5>Revenue Over Time</h5>
                    </div>
                    <div class="chart-container">
                        <canvas id="revenueOverTimeChart"></canvas>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const colors = {
            primary: '#667eea',
            success: '#43e97b',
            warning: '#f59e0b'
        };

        // Events by Status
        new Chart(document.getElementById('eventsByStatusChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EventsByStatus.Keys)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EventsByStatus.Values)),
                    backgroundColor: [colors.primary, colors.success, colors.warning]
                }]
            }
        });

        // Registrations per Event
        new Chart(document.getElementById('registrationsPerEventChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RegistrationsPerEvent.Keys)),
                datasets: [{
                    label: 'Registrations',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RegistrationsPerEvent.Values)),
                    backgroundColor: colors.primary
                }]
            }
        });

        // Revenue Over Time
        new Chart(document.getElementById('revenueOverTimeChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueOverTime.Keys)),
                datasets: [{
                    label: 'Revenue',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueOverTime.Values)),
                    borderColor: colors.success,
                    fill: false,
                    tension: 0.4
                }]
            }
        });
    </script>
}
