@model Event_Management_System.DTOs.AdminDashboardKpiDTO
@{
    ViewData["Title"] = "Admin Dashboard";

    var avgTicketPrice = (Model.TotalRegistrations > 0 && Model.TotalRevenue.HasValue)
        ? Math.Round(Model.TotalRevenue.Value / Model.TotalRegistrations, 2)
        : 0m;
}

<style>
    .dashboard-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 16px;
        padding: 1.5rem 2rem;
        margin-bottom: 1.5rem;
        color: white;
        box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3);
    }

        .dashboard-hero h1 {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .dashboard-hero p {
            font-size: 0.95rem;
            opacity: 0.95;
            margin: 0;
        }

    .stat-card {
        border: none;
        border-radius: 12px;
        padding: 1rem;
        transition: all 0.3s ease;
        background: white;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            transition: height 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.2);
        }

            .stat-card:hover::before {
                height: 4px;
            }

    .stat-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.15) 0%, rgba(118, 75, 162, 0.15) 100%);
        color: #667eea;
    }

    .stat-card .card-body {
        padding: 0;
    }

    .stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1a1a2e;
        line-height: 1;
        margin: 0;
    }

    .dashboard-actions {
        background: white;
        padding: 1.25rem;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .action-btn {
        border: none;
        border-radius: 12px;
        padding: 1.5rem 1rem;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
        height: 140px;
        text-align: center;
        text-decoration: none;
        width: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

        .action-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
            text-decoration: none;
            background: linear-gradient(135deg, #5568d3 0%, #653a8b 100%);
            color: white;
        }

        .action-btn .btn-icon {
            font-size: 2rem;
            line-height: 1;
        }

        .action-btn .btn-text {
            font-size: 0.9rem;
            line-height: 1.3;
        }

    .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 1rem;
    }

    @@media (max-width: 1400px) {
        .action-btn {
            padding: 1.25rem 0.75rem;
            height: 130px;
        }

            .action-btn .btn-icon {
                font-size: 1.75rem;
            }

            .action-btn .btn-text {
                font-size: 0.85rem;
            }
    }

    @@media (max-width: 1200px) {
        .action-btn {
            height: 120px;
            padding: 1rem 0.75rem;
        }

            .action-btn .btn-icon {
                font-size: 1.5rem;
            }
    }

    @@media (max-width: 768px) {
        .dashboard-hero h1 {
            font-size: 1.5rem;
        }

        .stat-value {
            font-size: 1.5rem;
        }

        .action-btn {
            height: 110px;
        }
    }
</style>

<!-- Hero Header -->
<div class="dashboard-hero text-center">
    <h1>⚡ Admin Dashboard</h1>
    <p>Monitor and manage your event management system</p>
</div>

<!-- Stats Section -->
<div class="row mb-2 g-3">
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">👥</div>
                <div class="stat-label">Total Users</div>
                <h3 class="stat-value">@Model.TotalUsers</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">🎯</div>
                <div class="stat-label">Organizers</div>
                <h3 class="stat-value">@Model.TotalOrganizers</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">📅</div>
                <div class="stat-label">Total Events</div>
                <h3 class="stat-value">@Model.TotalEvents</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">⏰</div>
                <div class="stat-label">Upcoming Events</div>
                <h3 class="stat-value">@Model.UpcomingEvents</h3>
            </div>
        </div>
    </div>
</div>

<!-- Second Row Stats -->
<div class="row mb-2 g-3">
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">🎫</div>
                <div class="stat-label">Registrations</div>
                <h3 class="stat-value">@Model.TotalRegistrations</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">💰</div>
                <div class="stat-label">Revenue</div>
                <h3 class="stat-value">@Model.TotalRevenue PKR</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">⚠️</div>
                <div class="stat-label">Pending Requests</div>
                <h3 class="stat-value">@Model.PendingOrganizerRequests</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-icon">🏷️</div>
                <div class="stat-label">Avg. Ticket</div>
                <h3 class="stat-value">@avgTicketPrice PKR</h3>
            </div>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="dashboard-actions">
    <h2 class="section-title">Quick Management Actions</h2>
    <div class="row g-3">
        <div class="col">
            <a asp-controller="OrganizerApplication" asp-action="ViewOrganizerApplications" class="action-btn">
                <span class="btn-icon">✅</span>
                <span class="btn-text">Verify Organizers</span>
            </a>
        </div>
        <div class="col">
            <a asp-action="Events" class="action-btn">
                <span class="btn-icon">📋</span>
                <span class="btn-text">Manage Events</span>
            </a>
        </div>
        <div class="col">
            <a asp-action="Analytics" class="action-btn">
                <span class="btn-icon">📈</span>
                <span class="btn-text">System Analytics</span>
            </a>
        </div>
    </div>
</div>