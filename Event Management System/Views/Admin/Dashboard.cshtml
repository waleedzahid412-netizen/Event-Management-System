@model Event_Management_System.DTOs.AdminDashboardKpiDTO
@{
    ViewData["Title"] = "Admin Dashboard";

    var avgTicketPrice = (Model.TotalRegistrations > 0 && Model.TotalRevenue.HasValue)
        ? Math.Round(Model.TotalRevenue.Value / Model.TotalRegistrations, 2)
        : 0m;
}

<div class="container-fluid py-5 min-vh-100" style="background-color: #eef2f6;">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h2 class="fw-bold text-dark">Admin Dashboard</h2>
                <p class="text-muted mb-0">System performance overview</p>
            </div>
            <div class="bg-white px-4 py-2 rounded-pill shadow-sm">
                <i class="bi bi-calendar3 me-2 text-primary"></i>
                <span class="fw-bold text-dark">@DateTime.Now.ToString("MMM dd, yyyy")</span>
            </div>
        </div>

        <h5 class="text-muted fw-bold mb-3 text-uppercase small ls-1">Key Metrics</h5>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 mb-5">

            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between">
                            <div>
                                <p class="text-muted fw-bold small mb-1">TOTAL USERS</p>
                                <h3 class="fw-bold text-dark mb-0">@Model.TotalUsers</h3>
                            </div>
                            <div class="icon-box bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-people-fill fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between">
                            <div>
                                <p class="text-muted fw-bold small mb-1">ORGANIZERS</p>
                                <h3 class="fw-bold text-dark mb-0">@Model.TotalOrganizers</h3>
                            </div>
                            <div class="icon-box bg-info bg-opacity-10 text-info">
                                <i class="bi bi-person-badge-fill fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between">
                            <div>
                                <p class="text-muted fw-bold small mb-1">TOTAL EVENTS</p>
                                <h3 class="fw-bold text-dark mb-0">@Model.TotalEvents</h3>
                            </div>
                            <div class="icon-box bg-success bg-opacity-10 text-success">
                                <i class="bi bi-calendar-event-fill fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between">
                            <div>
                                <p class="text-muted fw-bold small mb-1">UPCOMING</p>
                                <h3 class="fw-bold text-dark mb-0">@Model.UpcomingEvents</h3>
                            </div>
                            <div class="icon-box bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-hourglass-split fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between">
                            <div>
                                <p class="text-muted fw-bold small mb-1">REGISTRATIONS</p>
                                <h3 class="fw-bold text-dark mb-0">@Model.TotalRegistrations</h3>
                            </div>
                            <div class="icon-box bg-secondary bg-opacity-10 text-secondary">
                                <i class="bi bi-ticket-perforated-fill fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift position-relative overflow-hidden">
                    <div class="card-body p-4 position-relative z-2">
                        <div class="d-flex justify-content-between">
                            <div>
                                <p class="text-muted fw-bold small mb-1">REVENUE</p>
                                <h3 class="fw-bold text-success mb-0">@Model.TotalRevenue</h3>
                                <small class="text-muted" style="font-size: 0.7rem;">PKR Currency</small>
                            </div>
                            <div class="icon-box bg-success bg-opacity-10 text-success">
                                <i class="bi bi-wallet-fill fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift @(Model.PendingOrganizerRequests > 0 ? "border-start border-4 border-danger" : "")">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between">
                            <div>
                                <p class="text-muted fw-bold small mb-1">PENDING REQUESTS</p>
                                <h3 class="fw-bold @(Model.PendingOrganizerRequests > 0 ? "text-danger" : "text-dark") mb-0">
                                    @Model.PendingOrganizerRequests
                                </h3>
                            </div>
                            <div class="icon-box bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between">
                            <div>
                                <p class="text-muted fw-bold small mb-1">AVG. TICKET</p>
                                <h3 class="fw-bold text-dark mb-0">PKR @avgTicketPrice</h3>
                            </div>
                            <div class="icon-box bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-tags-fill fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="text-muted fw-bold mb-3 text-uppercase small ls-1">Quick Management</h5>
        <div class="row g-4">

            <div class="col-md-4">
                <a asp-controller="OrganizerApplication" asp-action="ViewOrganizerApplications" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-scale">
                        <div class="card-body p-4 text-center">
                            <div class="action-icon mx-auto mb-3 bg-white shadow-sm text-primary rounded-circle">
                                <i class="bi bi-person-check fs-3"></i>
                            </div>
                            <h5 class="fw-bold text-dark">Verify Organizers</h5>
                            <p class="text-muted small">Review pending applications</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-action="Events" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-scale">
                        <div class="card-body p-4 text-center">
                            <div class="action-icon mx-auto mb-3 bg-white shadow-sm text-purple rounded-circle">
                                <i class="bi bi-calendar-range fs-3"></i>
                            </div>
                            <h5 class="fw-bold text-dark">Manage Events</h5>
                            <p class="text-muted small">Edit, feature or cancel events</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-action="Analytics" class="text-decoration-none">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-scale">
                        <div class="card-body p-4 text-center">
                            <div class="action-icon mx-auto mb-3 bg-white shadow-sm text-success rounded-circle">
                                <i class="bi bi-graph-up-arrow fs-3"></i>
                            </div>
                            <h5 class="fw-bold text-dark">System Analytics</h5>
                            <p class="text-muted small">View financial reports</p>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    </div>
</div>

<style>
    /* 1. Icon Styling */
    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* 2. Action Buttons Styling */
    .action-icon {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    /* 3. Hover Effects for KPI Cards */
    .hover-lift {
        background-color: #ffffff; /* Explicitly set White Card Background */
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important; /* Soft large shadow on hover */
        }

    /* 4. Hover Effects for Action Cards */
    .hover-scale {
        background-color: #ffffff;
        transition: transform 0.2s;
    }

        .hover-scale:hover {
            transform: scale(1.02);
        }

            .hover-scale:hover .action-icon {
                background-color: #f8f9fa !important;
                transform: rotate(10deg);
            }

    /* 5. Typography */
    .ls-1 {
        letter-spacing: 1px;
    }

    .text-purple {
        color: #6f42c1;
    }
</style>