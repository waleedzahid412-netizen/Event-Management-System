@using Event_Management_System.Models.Entities
@model IEnumerable<Event>

@{
    ViewData["Title"] = "Browse Events";

    var categories = ViewBag.Categories as List<EventCategory> ?? new();
    var recommended = ViewBag.RecommendedEvents as List<Event> ?? new();
    bool showRecommended = ViewBag.ShowRecommended == true;

    string selectedStatus = ViewBag.SelectedTab as string ?? "upcoming";
    string selectedCategory = Context.Request.Query["categoryId"];
}

<!-- Hero Header -->
<div class="hero-header text-white text-center py-5 mb-5 rounded-4 shadow-lg">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">🎉 Discover Amazing Events</h1>
        <p class="lead mb-0">Find and register for the best events in your area</p>
    </div>
</div>

<!-- Status Tabs -->
<ul class="nav nav-pills mb-4 justify-content-center">
    <li class="nav-item">
        <a class="nav-link @(selectedStatus == "upcoming" ? "active" : "")"
           asp-action="BrowseEvents"
           asp-route-status="upcoming"
           asp-route-categoryId="@selectedCategory">
            <i class="bi bi-calendar-event"></i> Upcoming Events
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(selectedStatus == "past" ? "active" : "")"
           asp-action="BrowseEvents"
           asp-route-status="past"
           asp-route-categoryId="@selectedCategory">
            <i class="bi bi-clock-history"></i> Past Events
        </a>
    </li>
</ul>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-5 filter-bar">
    <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between">

        <form method="get" asp-action="BrowseEvents" class="d-flex gap-3 align-items-center flex-wrap">
            <input type="hidden" name="status" value="@selectedStatus" />

            <div class="filter-group">
                <label class="fw-semibold text-muted mb-2 d-block">
                    <i class="bi bi-funnel"></i> Filter by Category
                </label>
                <select name="categoryId" class="form-select form-select-lg custom-select">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.CategoryId"
                                selected="@(selectedCategory == cat.CategoryId.ToString())">
                            @cat.CategoryName
                        </option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary btn-lg px-5 custom-btn mt-auto">
                <i class="bi bi-search"></i> Apply Filter
            </button>
        </form>

        <form method="get" asp-action="BrowseEvents">
            <input type="hidden" name="showRecommended" value="true" />
            <button type="submit" class="btn btn-warning btn-lg px-5 custom-btn">
                <i class="bi bi-star-fill"></i> Show Recommended
            </button>
        </form>

    </div>
</div>

<!-- Recommended Section -->
@if (showRecommended)
{
    <div class="section-header mb-4">
        <h2 class="fw-bold">🌟 Recommended for You</h2>
        <p class="text-muted">Handpicked events based on your interests</p>
    </div>

    @if (!recommended.Any())
    {
        <div class="alert alert-info rounded-4 shadow-sm border-0 p-4">
            No recommendations available yet.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in recommended)
            {
                <partial name="_EventCard" model="ev" />
            }
        </div>
    }
}

<!-- All Events -->
@if (!showRecommended)
{
    <div class="section-header mb-4">
        <h2 class="fw-bold">
            @(selectedStatus == "past" ? "Past Events" : "Upcoming Events")
        </h2>
        <p class="text-muted">
            @(selectedStatus == "past"
                    ? "Browse previously held events"
                    : "Browse our upcoming events")
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning rounded-4 shadow-sm border-0 p-4">
            No events found.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var ev in Model)
            {
                <div class="col">
                    <div class="card event-card h-100 border-0 rounded-4 shadow-hover">
                        <img src="@ev.CoverImageUrl" class="card-img-top event-img" />

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="fw-bold">@ev.Title</h5>

                            <p class="text-muted small mb-1">
                                <i class="bi bi-calendar-event"></i>
                                @ev.StartDate.ToString("MMM dd, yyyy")
                                -
                                @ev.EndDate.ToString("MMM dd, yyyy")
                            </p>

                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt-fill"></i>
                                @ev.Location
                            </p>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-controller="Event"
                                   asp-action="EventDetails"
                                   asp-route-id="@ev.EventId"
                                   class="btn btn-outline-primary w-50">
                                    Details
                                </a>

                                @if (selectedStatus == "upcoming")
                                {
                                    <a asp-controller="EventRegistration"
                                       asp-action="RegisterEvent"
                                       asp-route-id="@ev.EventId"
                                       class="btn btn-success w-50">
                                        Register
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
