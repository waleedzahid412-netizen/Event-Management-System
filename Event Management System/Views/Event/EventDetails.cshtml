@model Event_Management_System.ViewModels.EventDetailsPageViewModel

@{
    ViewData["Title"] = "Event Details";
}

<!-- Modern Header with Glassmorphism -->
<div class="modern-hero">
    <div class="hero-background"></div>
    <div class="container">
        <div class="hero-content">
            <a asp-controller="Organizer" asp-action="MyEvents" class="back-link">
                <i class="bi bi-arrow-left-circle-fill"></i>
                <span>Back to Events</span>
            </a>
            <div class="hero-title-area">
                <span class="category-pill">
                    <i class="bi bi-tag-fill"></i>
                    @Model.Event.CategoryName
                </span>
                <h1 class="hero-title">@Model.Event.Title</h1>
                <div class="hero-meta">
                    <div class="meta-item">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>@Model.Event.Location</span>
                    </div>
                    <div class="meta-divider"></div>
                    <div class="meta-item">
                        <i class="bi bi-calendar-event"></i>
                        <span>@Model.Event.StartDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="meta-divider"></div>
                    <div class="meta-item seats-indicator">
                        <i class="bi bi-people-fill"></i>
                        <span>@Model.Event.AvailableSeats / @Model.Event.TotalSeats Available</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container main-container">
    <!-- Event Showcase Card -->
    <div class="event-showcase-card">
        <div class="row g-0">
            <!-- Cover Image -->
            <div class="col-lg-5">
                <div class="showcase-image-wrapper">
                    <img src="@Model.Event.CoverImageUrl" class="showcase-image" alt="@Model.Event.Title" />
                    <div class="image-gradient"></div>
                </div>
            </div>

            <!-- Event Info -->
            <div class="col-lg-7">
                <div class="showcase-content">
                    <div class="content-section">
                        <h3 class="section-heading">
                            <i class="bi bi-info-circle-fill"></i>
                            About This Event
                        </h3>
                        <p class="event-description">@Model.Event.Description</p>
                    </div>

                    <div class="content-section">
                        <h3 class="section-heading">
                            <i class="bi bi-calendar-check-fill"></i>
                            Event Details
                        </h3>
                        <div class="info-grid">
                            <div class="info-card">
                                <div class="info-icon start">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                                <div class="info-text">
                                    <span class="info-label">Start Date</span>
                                    <span class="info-value">@Model.Event.StartDate.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                            <div class="info-card">
                                <div class="info-icon end">
                                    <i class="bi bi-calendar-x"></i>
                                </div>
                                <div class="info-text">
                                    <span class="info-label">End Date</span>
                                    <span class="info-value">@Model.Event.EndDate.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                            <div class="info-card">
                                <div class="info-icon capacity">
                                    <i class="bi bi-ticket-perforated-fill"></i>
                                </div>
                                <div class="info-text">
                                    <span class="info-label">Total Capacity</span>
                                    <span class="info-value">@Model.Event.TotalSeats Seats</span>
                                </div>
                            </div>
                            <div class="info-card">
                                <div class="info-icon available">
                                    <i class="bi bi-ticket-detailed-fill"></i>
                                </div>
                                <div class="info-text">
                                    <span class="info-label">Available</span>
                                    <span class="info-value">@Model.Event.AvailableSeats Seats</span>
                                </div>
                            </div>
                        </div>

                        @{
                            var bookedSeats = Model.Event.TotalSeats - Model.Event.AvailableSeats;
                            var progressPercent = ((double)bookedSeats / Model.Event.TotalSeats) * 100;
                        }
                        <div class="booking-progress">
                            <div class="progress-header">
                                <span class="progress-label">Booking Progress</span>
                                <span class="progress-percentage">@progressPercent.ToString("F0")%</span>
                            </div>
                            <div class="modern-progress-bar">
                                <div class="progress-track">
                                    <div class="progress-fill" style="width: @progressPercent%">
                                        <div class="progress-glow"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="progress-stats">
                                <span><strong>@bookedSeats</strong> Booked</span>
                                <span><strong>@Model.Event.AvailableSeats</strong> Remaining</span>
                            </div>
                        </div>
                    </div>

                    @if (User.IsInRole("Organizer"))
                    {
                        <div class="action-buttons">
                            <a asp-controller="Organizer" asp-action="EditEvent" asp-route-id="@Model.Event.EventId" class="btn-action edit">
                                <i class="bi bi-pencil-square"></i>
                                <span>Edit Event</span>
                            </a>
                            <a asp-controller="Organizer" asp-action="ViewEventParticipants" asp-route-id="@Model.Event.EventId" class="btn-action participants">
                                <i class="bi bi-people-fill"></i>
                                <span>View Participants</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Venue Gallery -->
    @if (Model.Event.VenueImages != null && Model.Event.VenueImages.Any())
    {
        <div class="venue-gallery-card">
            <div class="card-header-modern">
                <div class="header-icon venue">
                    <i class="bi bi-building"></i>
                </div>
                <div>
                    <h3 class="card-title-modern">Venue Gallery</h3>
                    <p class="card-subtitle">Explore the event location</p>
                </div>
            </div>

            <div id="venueCarousel" class="carousel slide modern-carousel" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.Event.VenueImages.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Model.Event.VenueImages[i]" class="modern-venue-image" alt="Venue @(i + 1)" />
                            <div class="image-counter">@(i + 1) / @Model.Event.VenueImages.Count</div>
                        </div>
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#venueCarousel" data-bs-slide="prev">
                    <div class="modern-control-btn">
                        <i class="bi bi-chevron-left"></i>
                    </div>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#venueCarousel" data-bs-slide="next">
                    <div class="modern-control-btn">
                        <i class="bi bi-chevron-right"></i>
                    </div>
                </button>

                <div class="carousel-indicators modern-indicators">
                    @for (int i = 0; i < Model.Event.VenueImages.Count; i++)
                    {
                        <button type="button" data-bs-target="#venueCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- SIMILAR EVENTS - LINKEDIN SHOWCASE SECTION -->
    @if (Model.SimilarEvents.Any())
    {
        <div class="recommendations-section">
            <!-- Feature Explanation Banner -->
            <div class="feature-banner">
                <div class="banner-icon">
                    <i class="bi bi-lightbulb-fill"></i>
                </div>
                <div class="banner-content">
                    <h2 class="banner-title">Smart Event Recommendations</h2>
                    <p class="banner-description">Based on "<strong>@Model.Event.CategoryName</strong>" category, our AI suggests these similar events you might enjoy</p>
                </div>
                <div class="banner-badge">
                    <i class="bi bi-stars"></i>
                    AI-Powered
                </div>
            </div>

            <!-- Connection Indicator -->
            <div class="connection-flow">
                <div class="flow-item current-event">
                    <div class="flow-icon">
                        <i class="bi bi-eye-fill"></i>
                    </div>
                    <div class="flow-text">
                        <span class="flow-label">You're viewing</span>
                        <span class="flow-value">@Model.Event.Title</span>
                    </div>
                </div>

                <div class="flow-arrow">
                    <i class="bi bi-arrow-right"></i>
                    <span class="arrow-label">Recommends</span>
                </div>

                <div class="flow-item recommended-events">
                    <div class="flow-icon">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <div class="flow-text">
                        <span class="flow-label">Similar Events</span>
                        <span class="flow-value">@Model.SimilarEvents.Count Events Found</span>
                    </div>
                </div>
            </div>

            <!-- Similar Events Grid -->
            <div class="recommendations-grid">
                @foreach (var ev in Model.SimilarEvents)
                {
                    <div class="recommendation-card">
                        <div class="recommendation-badge">
                            <i class="bi bi-patch-check-fill"></i>
                            <span>Recommended</span>
                        </div>

                        <a asp-controller="Event" asp-action="EventDetails" asp-route-id="@ev.EventId" class="card-link">
                            <div class="card-image-container">
                                <img src="@ev.CoverImageUrl" class="card-image" alt="@ev.Title" />
                                <div class="card-overlay"></div>
                                <div class="availability-badge">
                                    <i class="bi bi-people-fill"></i>
                                    <span>@ev.AvailableSeats / @ev.TotalSeats</span>
                                </div>
                            </div>

                            <div class="card-body-modern">
                                <h4 class="card-title-event">@ev.Title</h4>

                                <div class="card-details">
                                    <div class="detail-row">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        <span>@ev.Location</span>
                                    </div>
                                    <div class="detail-row">
                                        <i class="bi bi-calendar-event"></i>
                                        <span>@ev.StartDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>

                                <div class="card-footer-action">
                                    <span class="view-btn">
                                        View Event
                                        <i class="bi bi-arrow-right-circle-fill"></i>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>

            <!-- Feature Highlight Footer -->
            <div class="feature-footer">
                <div class="footer-icon">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <p class="footer-text">
                    Our recommendation engine analyzes event categories, dates, and locations to suggest relevant events
                </p>
            </div>
        </div>
    }
</div>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --success-gradient: linear-gradient(135deg, #56CCF2 0%, #2F80ED 100%);
        --warning-gradient: linear-gradient(135deg, #F2C94C 0%, #F2994A 100%);
        --danger-gradient: linear-gradient(135deg, #EB5757 0%, #C92A2A 100%);
        --glass-bg: rgba(255, 255, 255, 0.95);
        --glass-border: rgba(255, 255, 255, 0.3);
        --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.12);
        --shadow-xl: 0 25px 80px rgba(0, 0, 0, 0.15);
    }

    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e9f2 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    /* Modern Hero Section */
    .modern-hero {
        position: relative;
        padding: 3rem 0 4rem;
        overflow: hidden;
        margin-bottom: 3rem;
    }

    .hero-background {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--primary-gradient);
        z-index: 0;
    }

        .hero-background::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
            opacity: 0.4;
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: white;
        text-decoration: none;
        font-weight: 600;
        margin-bottom: 2rem;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }

        .back-link:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(-5px);
            color: white;
        }

        .back-link i {
            font-size: 1.25rem;
        }

    .hero-title-area {
        color: white;
    }

    .category-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 0.5rem 1.25rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .hero-title {
        font-size: 3rem;
        font-weight: 800;
        margin: 0 0 1.5rem 0;
        line-height: 1.2;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .hero-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        font-weight: 500;
    }

        .meta-item i {
            font-size: 1.25rem;
        }

    .meta-divider {
        width: 1px;
        height: 20px;
        background: rgba(255, 255, 255, 0.3);
    }

    .seats-indicator {
        background: rgba(86, 204, 242, 0.3);
        padding: 0.5rem 1rem;
        border-radius: 50px;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Main Container */
    .main-container {
        max-width: 1400px;
        padding-bottom: 4rem;
    }

    /* Event Showcase Card */
    .event-showcase-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: var(--shadow-lg);
        margin-bottom: 2rem;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .showcase-image-wrapper {
        position: relative;
        height: 100%;
        min-height: 500px;
        overflow: hidden;
    }

    .showcase-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .image-gradient {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 50%;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.4), transparent);
    }

    .showcase-content {
        padding: 3rem;
    }

    .content-section {
        margin-bottom: 2.5rem;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a202c;
        margin-bottom: 1.5rem;
    }

        .section-heading i {
            color: #667eea;
            font-size: 1.75rem;
        }

    .event-description {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #4a5568;
        margin: 0;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .info-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem;
        background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
    }

        .info-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        }

    .info-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
        flex-shrink: 0;
    }

        .info-icon.start {
            background: var(--success-gradient);
        }

        .info-icon.end {
            background: var(--warning-gradient);
        }

        .info-icon.capacity {
            background: var(--primary-gradient);
        }

        .info-icon.available {
            background: var(--danger-gradient);
        }

    .info-text {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .info-label {
        font-size: 0.85rem;
        color: #718096;
        font-weight: 600;
    }

    .info-value {
        font-size: 1.125rem;
        color: #1a202c;
        font-weight: 700;
    }

    /* Booking Progress */
    .booking-progress {
        background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
        padding: 1.5rem;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .progress-label {
        font-weight: 700;
        color: #2d3748;
        font-size: 1rem;
    }

    .progress-percentage {
        font-size: 1.5rem;
        font-weight: 800;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .modern-progress-bar {
        margin-bottom: 1rem;
    }

    .progress-track {
        height: 12px;
        background: #e2e8f0;
        border-radius: 50px;
        overflow: hidden;
        position: relative;
    }

    .progress-fill {
        height: 100%;
        background: var(--primary-gradient);
        border-radius: 50px;
        position: relative;
        transition: width 0.6s ease;
    }

    .progress-glow {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 50px;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5));
        animation: shimmer 2s infinite;
    }

    @@keyframes shimmer {
        0%, 100% {
            opacity: 0;
        }

        50% {
            opacity: 1;
        }
    }

    .progress-stats {
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
        color: #718096;
    }

        .progress-stats strong {
            color: #2d3748;
            font-weight: 700;
        }

    /* Action Buttons */
    .action-buttons {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .btn-action {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        font-size: 1rem;
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

        .btn-action i {
            font-size: 1.25rem;
        }

        .btn-action.edit {
            background: var(--warning-gradient);
            color: white;
        }

            .btn-action.edit:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(242, 201, 76, 0.4);
            }

        .btn-action.participants {
            background: var(--success-gradient);
            color: white;
        }

            .btn-action.participants:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(86, 204, 242, 0.4);
            }

    /* Venue Gallery */
    .venue-gallery-card {
        background: white;
        border-radius: 24px;
        padding: 2rem;
        box-shadow: var(--shadow-lg);
        margin-bottom: 2rem;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .card-header-modern {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .header-icon {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        color: white;
        flex-shrink: 0;
    }

        .header-icon.venue {
            background: var(--primary-gradient);
        }

    .card-title-modern {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1a202c;
        margin: 0;
    }

    .card-subtitle {
        font-size: 0.95rem;
        color: #718096;
        margin: 0.25rem 0 0 0;
    }

    .modern-carousel {
        border-radius: 16px;
        overflow: hidden;
        position: relative;
    }

    .modern-venue-image {
        width: 100%;
        height: 500px;
        object-fit: cover;
    }

    .image-counter {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(10px);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.9rem;
        z-index: 2;
    }

    .modern-control-btn {
        width: 50px;
        height: 50px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #667eea;
        transition: all 0.3s ease;
    }

    .carousel-control-prev:hover .modern-control-btn,
    .carousel-control-next:hover .modern-control-btn {
        background: white;
        transform: scale(1.15);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .modern-indicators {
        bottom: 1rem;
    }

        .modern-indicators button {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.5);
            border: none;
            margin: 0 5px;
            transition: all 0.3s ease;
        }

            .modern-indicators button.active {
                width: 30px;
                border-radius: 5px;
                background: white;
            }

    /* RECOMMENDATIONS SECTION - LINKEDIN SHOWCASE */
    .recommendations-section {
        margin-top: 4rem;
    }

    /* Feature Banner */
    .feature-banner {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 24px;
        padding: 2.5rem;
        display: flex;
        align-items: center;
        gap: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
        position: relative;
        overflow: hidden;
    }

        .feature-banner::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            animation: pulse 3s ease-in-out infinite;
        }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            opacity: 0.5;
        }

